{
  "name": "frost",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"tools/**/*.mjs\" \"install/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"tools/**/*.mjs\" \"install/*.mjs\"",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/cli/main.js",
    "demo": "node dist/src/tui/demo.js",
    "audit:dependencies": "node tools/dependencies.mjs",
    "benchmark": "npm run build && node tools/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "arrowParens": "avoid"
  }
}
